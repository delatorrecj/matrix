FROM python:3.12-slim

# System libs only — NO apt SUMO package. The kernel depends on the `eclipse-sumo`
# Python wheel (pyproject.toml), which ships its own SUMO binaries. Installing the
# Ubuntu `sumo` package would shadow the wheel binaries and break sumo_env.py.
# eclipse-sumo also needs libgdal for geospatial I/O on Linux slim images.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgdal-dev \
    libproj-dev \
    libxml2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install uv (no global pip pollution)
RUN pip install --no-cache-dir uv

# Copy source (manifests first so Docker caches the install layer)
COPY packages/kernel/pyproject.toml ./packages/kernel/pyproject.toml
COPY apps/api/pyproject.toml ./apps/api/pyproject.toml
COPY packages/kernel ./packages/kernel
COPY apps/api ./apps/api

# Install kernel + API (uv resolves eclipse-sumo + all transitive deps)
RUN uv pip install --system --no-cache -e packages/kernel -e apps/api

# Net + demand files are gitignored large assets.  Mount a Fly persistent volume
# at /data before the first deploy (see fly.toml [mounts] + deploy runbook in
# docs/ops-matrix.md §7).  The env vars below tell the kernel where to look;
# a missing file is detected per-simulate call and surfaces as a clear error —
# it is NOT a startup failure so /health stays green.
ENV MATRIX_NET_PATH=/data/iloilo.net.xml \
    MATRIX_ROU_PATH=/data/iloilo.rou.xml

EXPOSE 8000

CMD ["uvicorn", "matrix_api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
