# The SUMO net (41 MB) + demand (2.2 MB) are large binaries — track them via Git LFS so
# they push to the HF Space cleanly (HF recommends LFS for files > 10 MB).
*.net.xml filter=lfs diff=lfs merge=lfs -text
*.rou.xml filter=lfs diff=lfs merge=lfs -text

# The entrypoint + Dockerfile MUST stay LF — a CRLF shebang breaks bash in the Linux
# container ("/usr/bin/env bash^M: no such file"). Pin it regardless of the OS that commits.
*.sh text eol=lf
start.sh text eol=lf
Dockerfile text eol=lf
